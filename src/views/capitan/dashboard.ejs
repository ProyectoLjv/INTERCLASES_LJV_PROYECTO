<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="dashboard-page">
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">CAPITÁN</p>
        <h1>Panel del capitán</h1>
      </div>
      <div class="header-actions">
        <span class="user-badge">Hola, <%= user.name %></span>
        <a class="btn btn-secondary" href="/logout">Cerrar sesión</a>
      </div>
    </header>

    <main class="dashboard-shell">
      <aside class="dashboard-sidebar">
        <nav>
          <a href="/capitan">Inicio</a>
          <a href="#mi-equipo">Mi equipo</a>
          <a href="#jugadores">Jugadores</a>
          <a href="#partidos">Partidos</a>
        </nav>
      </aside>

      <section class="dashboard-content">
        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert success"><%= success %></div>
        <% } %>

        <div class="panel-card" id="mi-equipo">
          <h2>Crear equipo</h2>
          <form class="dashboard-form" action="/capitan/equipos" method="post">
            <div class="field-row">
              <label>
                Nombre del equipo
                <input type="text" name="nombre" placeholder="Ej. Los Halcones" required>
              </label>

              <label>
                Categoría
                <input type="text" name="categoria" placeholder="Ej. Bachillerato" required>
              </label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar equipo</button>
          </form>
        </div>

        <div class="panel-card" id="jugadores">
          <h2>Añadir jugador</h2>
          <form class="dashboard-form" action="/capitan/jugadores" method="post">
            <div class="field-row">
              <label>
                Nombre del jugador
                <input type="text" name="nombre" placeholder="Ej. Carlos Torres" required>
              </label>

              <label>
                Posición
                <input type="text" name="posicion" placeholder="Ej. Delantero" required>
              </label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar jugador</button>
          </form>
        </div>

        <div class="panel-card" id="partidos">
          <h2>Próximos partidos</h2>
          <% if (!partidos || partidos.length === 0) { %>
            <p>No hay partidos programados todavía.</p>
          <% } else { %>
            <ul class="list-grid">
              <% partidos.forEach((partido) => { %>
                <li>
                  <strong><%= partido.equipo_local %></strong>
                  <span>vs.</span>
                  <strong><%= partido.equipo_visitante %></strong>
                  <small><%= partido.fecha_partido %> · <%= partido.hora_partido %></small>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </section>
    </main>
  </body>
</html>
