<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="modal-open">
  <header class="site-header">
    <div class="site-brand">
      <img
        class="site-logo"
        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQjyPasuwCjM-T9wsh9KY8AYvZD7m4WFiufQGn7CtHjNLxS7BpOdR9xHB2v&s=10"
        alt="Logo de la Institución Educativa Lucrecio Jaramillo Vélez"
      >
      <div>
      <p class="eyebrow">LJV / TEMPORADA 2026</p>
      <h1>Interclases de futbol</h1>
      <p>Lucrecio Jaramillo Velez</p>
      </div>
    </div>
    <div class="header-actions">
      <% if (user) { %>
        <span class="user-badge">Hola, <%= user.name %></span>
        <a class="btn btn-secondary" href="/logout">Cerrar sesión</a>
      <% } else { %>
        <a class="btn btn-secondary" href="/login">Iniciar sesión</a>
        <a class="btn btn-primary" href="/registro">Registrarse</a>
      <% } %>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <div>
        <p class="eyebrow">Comunidad deportiva</p>
        <h2>El colegio se encuentra en la cancha.</h2>
        <p>Consulta equipos, horarios y resultados de las interclases del LJV.</p>
      </div>
      <div class="ball">LJV</div>
    </section>

    <section class="stats" aria-label="Resumen del torneo">
      <article><strong><%= summary.teamCount %></strong><span>Equipos inscritos</span></article>
      <article><strong><%= summary.matchCount %></strong><span>Partidos programados</span></article>
    </section>

    <section class="schedule">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Agenda</p>
          <h2>Proximos partidos</h2>
        </div>
        <a href="/api/partidos">Ver API</a>
      </div>
      <% if (matches.length === 0) { %>
        <p>No hay partidos programados.</p>
      <% } else { %>
        <div class="matches">
          <% matches.forEach((match) => { %>
            <article class="match">
              <time datetime="<%= match.date %>"><%= match.date %> · <%= match.time %></time>
              <div>
                <strong><%= match.homeTeam %></strong>
                <span>vs.</span>
                <strong><%= match.awayTeam %></strong>
              </div>
              <small>
                <%= match.status %>
                <% if (match.result) { %>
                  <br>
                  <span><%= match.result %></span>
                <% } %>
              </small>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <footer>
    <p>Institución Educativa Lucrecio Jaramillo Vélez</p>
    <p class="sede-principal">Sede Principal</p>
    <p>Dirección: Carrera 79 No. 38 - 59 Barrio Laureles, Medellín, Antioquia, Colombia</p>
  </footer>

  <div class="welcome-modal" id="welcome-modal" role="dialog" aria-modal="true" aria-labelledby="welcome-title">
    <div class="welcome-card">
      <button class="welcome-close" type="button" aria-label="Cerrar mensaje de bienvenida">&times;</button>
      <p class="eyebrow welcome-season">LJV / TEMPORADA 2026</p>
      <h2 id="welcome-title">¡Bienvenidos!</h2>
      <p>Bienvenidos a las Interclases del colegio Lucrecio Jaramillo Vélez.</p>
      <button class="btn btn-primary welcome-button" type="button">Continuar</button>
    </div>
  </div>

  <script>
    const welcomeModal = document.getElementById('welcome-modal');
    const closeWelcomeButtons = welcomeModal.querySelectorAll('.welcome-close, .welcome-button');

    function closeWelcomeModal() {
      welcomeModal.classList.add('is-hidden');
      document.body.classList.remove('modal-open');
    }

    closeWelcomeButtons.forEach((button) => button.addEventListener('click', closeWelcomeModal));
    welcomeModal.addEventListener('click', (event) => {
      if (event.target === welcomeModal) closeWelcomeModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeWelcomeModal();
    });
  </script>
</body>
</html>
