<div class="floating-tools" aria-label="Herramientas de accesibilidad y configuración">
  <div class="floating-tool floating-tool--left">
    <button class="floating-tool__button floating-tool__button--accessibility" id="accessibility-toggle" type="button" aria-label="Abrir panel de accesibilidad" aria-expanded="false" aria-controls="accessibility-panel" title="Opciones de accesibilidad">
      <span class="floating-tool__icon-wrapper" aria-hidden="true">
        <svg class="floating-tool__icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="7.5" r="1.2" fill="currentColor" stroke="none"></circle>
          <path d="M7 10.5c2.5-1 7.5-1 10 0"></path>
          <path d="M12 10.5V16"></path>
          <path d="m9 20 3-4 3 4"></path>
        </svg>
      </span>
      <span class="floating-tool__label">Accesibilidad</span>
      <span class="floating-tool__chevron" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="m18 15-6-6-6 6"></path>
        </svg>
      </span>
    </button>

    <section class="floating-panel accessibility-panel" id="accessibility-panel" aria-labelledby="accessibility-title" hidden>
      <div class="floating-panel__header">
        <div class="floating-panel__header-title">
          <svg class="floating-panel__title-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="7.5" r="1.2" fill="currentColor" stroke="none"></circle>
            <path d="M7 10.5c2.5-1 7.5-1 10 0"></path>
            <path d="M12 10.5V16"></path>
            <path d="m9 20 3-4 3 4"></path>
          </svg>
          <h2 id="accessibility-title">Accesibilidad</h2>
        </div>
        <span class="floating-panel__badge">Ajustes</span>
      </div>

      <div class="accessibility-group">
        <span class="accessibility-group__label">Tamaño del texto</span>
        <div class="accessibility-actions" aria-label="Tamaño del texto">
          <button type="button" data-font-action="decrease" title="Reducir tamaño del texto" aria-label="Disminuir tamaño de letra">
            <span aria-hidden="true">A-</span>
            <small>Reducir</small>
          </button>
          <button type="button" data-font-action="increase" title="Aumentar tamaño del texto" aria-label="Aumentar tamaño de letra">
            <span aria-hidden="true">A+</span>
            <small>Aumentar</small>
          </button>
        </div>
      </div>

      <div class="accessibility-switches">
        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Alto contraste</span>
            <span class="setting-switch__description">Fondo negro y texto resaltado</span>
          </span>
          <input type="checkbox" data-accessibility="contrast" aria-label="Activar alto contraste">
          <span class="switch-track" aria-hidden="true"></span>
        </label>

        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Lectura clara</span>
            <span class="setting-switch__description">Tipografía y espacio optimizados</span>
          </span>
          <input type="checkbox" data-accessibility="reading" aria-label="Activar lectura clara">
          <span class="switch-track" aria-hidden="true"></span>
        </label>
      </div>

      <button class="floating-panel__reset" type="button" data-accessibility="reset" aria-label="Restablecer ajustes de accesibilidad">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
        <span>Restablecer ajustes</span>
      </button>
    </section>
  </div>

  <div class="floating-tool floating-tool--right">
    <button class="floating-tool__button floating-tool__button--settings" id="settings-toggle" type="button" aria-label="Abrir configuración de apariencia" aria-expanded="false" aria-controls="settings-panel" title="Configuración de apariencia">
      <span class="floating-tool__icon-wrapper" aria-hidden="true">
        <svg class="floating-tool__icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
        </svg>
      </span>
      <span class="floating-tool__label floating-tool__label--desktop-only">Tema</span>
    </button>
    <section class="floating-panel settings-panel" id="settings-panel" aria-labelledby="settings-title" hidden>
      <div class="floating-panel__header">
        <div class="floating-panel__header-title">
          <svg class="floating-panel__title-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
          </svg>
          <h2 id="settings-title">Configuración</h2>
        </div>
      </div>
      <label class="setting-switch">
        <span class="setting-switch__info">
          <span class="setting-switch__title">Tema oscuro</span>
          <span class="setting-switch__description">Cambiar a colores oscuros</span>
        </span>
        <input type="checkbox" data-theme-toggle aria-label="Alternar tema oscuro">
        <span class="switch-track" aria-hidden="true"></span>
      </label>
    </section>
  </div>
</div>
<script src="/js/accessibility-settings.js" defer></script>
