<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro | Interclases LJV</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <div class="auth-brand">
          <p class="eyebrow">INTERCLASES LJV</p>
          <h1>Crear cuenta</h1>
          <p>Regístrate para participar en la comunidad deportiva del colegio.</p>
        </div>

        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
        <% } %>

        <form class="auth-form" action="/register" method="post">
          <label>
            <span>Nombre completo</span>
            <input type="text" name="nombre" placeholder="Tu nombre" value="<%= formData.nombre || '' %>" required>
          </label>

          <label>
            <span>Correo electrónico</span>
            <input type="email" name="email" placeholder="correo@ejemplo.com" value="<%= formData.email || '' %>" required>
          </label>

          <label>
            <span>Contraseña</span>
            <input type="password" name="password" placeholder="Crea una contraseña" required>
          </label>

          <label>
            <span>Confirmar contraseña</span>
            <input type="password" name="confirmPassword" placeholder="Repite la contraseña" required>
          </label>

          <button type="submit">Registrarme</button>
        </form>

        <p class="auth-footer">
          ¿Ya tienes cuenta?
          <a href="/login">Inicia sesión</a>
        </p>

        <a class="text-link" href="/">Volver al inicio</a>
      </section>
    </main>
  </body>
</html>
